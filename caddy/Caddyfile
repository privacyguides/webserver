(pg-umami-config) {
	umami {
		event_endpoint https://stats.jonaharagon.net/api/send
		website_uuid 30b92047-7cbb-4800-9815-2e075a293e0a
		# bit of a hack to get umami working properly, nothing to do with cloudflare
