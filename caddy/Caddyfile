direct-garage.privacyguides.org, www.privacyguides.org {
	@matrix path /.well-known/matrix/*
	handle @matrix {
		reverse_proxy https://matrix.privacyguides.org {
			header_up Host matrix.privacyguides.org
			header_up X-Forwarded-Port {http.request.port}
			header_up X-Forwarded-TlsProto {tls_protocol}
			header_up X-Forwarded-TlsCipher {tls_cipher}
			header_up X-Forwarded-HttpsProto {proto}
		}
	}

	@assets path_regexp assets /([a-zA-Z0-9]*)/assets/(.*)$
	handle @assets {
		redir https://bunnycdn.privacyguides.org/{re.assets.1}/assets/{re.assets.2} permanent
	}

	handle / {
		import pg-matchers
		import pg-redirects-lang
	}

	handle {
		import garage-web
		import hsts
		# import pg-umami-config
		import pg-matchers
		import pg-headers
		import pg-redirects
		import pg-redirects-lang
		import pg-redirects-outdated
		import pg-canonical

		encode zstd gzip

		header +Link "<https://bunnycdn.privacyguides.org/>; rel=preconnect"
		header +Link "<https://api.github.com/>; rel=dns-prefetch"
		header /en/ +Link "<https://discuss.privacyguides.net/>; rel=preconnect"
		header /en/ +Link "<https://forum-cdn.privacyguides.net/>; rel=preconnect"
	}
}

